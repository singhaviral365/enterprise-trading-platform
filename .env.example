# Every environment variable the platform uses, by the part that reads it. Copy it to .env and fill in the blanks (or let
# `node config/cli.js env-file` write .env from config/application.yml). Generated from config/application.example.yml, so it stays in step.
# Blank = a secret or an account you must supply: passwords, API keys, the JWT secret, the encryption key, the SMTP account.

# ---- Shared by the auth, order and executor services
JWT_SECRET=
JWT_ISSUER=auth-service
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ---- auth-service (NestJS)
NODE_ENV=local
PORT=3000
LOG_LEVEL=debug
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=auth_db
DATABASE_USER=postgres
DATABASE_PASSWORD=
JWT_ACCESS_TOKEN_EXPIRES_IN=900
JWT_REFRESH_TOKEN_EXPIRES_IN=604800
AUTH_COOKIE_SECURE=
AUTH_COOKIE_SAMESITE=strict
AUTH_CORS_ORIGINS=http://localhost:4200
AUTH_EMAIL_VERIFICATION_ENABLED=false
AUTH_TWO_FACTOR_ENABLED=true
AUTH_OTP_SECRET=
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_RESET_TTL_SECONDS=600
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN_SECONDS=30
AUTH_OTP_MAX_SENDS=3
AUTH_EMAIL_MODE=off
AUTH_EMAIL_SMTP_HOST=
AUTH_EMAIL_SMTP_PORT=
AUTH_EMAIL_SMTP_TLS=starttls
AUTH_EMAIL_SMTP_USER=
AUTH_EMAIL_SMTP_PASSWORD=
AUTH_EMAIL_FROM=noreply@etpteamriya.com
AUTH_EMAIL_FROM_DOMAINS=etpteamriya.com
AUTH_EMAIL_ALLOWED_RECIPIENT_DOMAINS=
AUTH_EMAIL_REPLY_TO=
MAILHOG_HOST=localhost
MAILHOG_SMTP_PORT=1025
ENC_MODE=off
ENC_KID=
ENC_PRIVATE_KEY_PEM=
ENC_MAX_AGE_SECONDS=60
ENC_LOG_PLAINTEXT=false

# ---- order-service (Spring Boot)
SPRING_PROFILES_ACTIVE=
SERVICES_ORDER_PORT=8081
SERVICES_MAILHOG_HOST=localhost
SERVICES_MAILHOG_SMTP_PORT=1025
DATABASE_TRADING_HOST=localhost
DATABASE_TRADING_PORT=5432
DATABASE_TRADING_NAME=trading_db
DATABASE_TRADING_USER=postgres
DATABASE_TRADING_PASSWORD=
EXTERNAL_FAUXNANCE_BASE_URL=
EXTERNAL_FAUXNANCE_API_KEY=
EXTERNAL_EXCHANGE_RATE_BASE_URL=https://v6.exchangerate-api.com/v6
EXTERNAL_EXCHANGE_RATE_API_KEY=
EXTERNAL_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
EXTERNAL_GEMINI_API_KEY=
EXTERNAL_GEMINI_MODEL=gemini-flash-lite-latest
EXTERNAL_GEMINI_RATE_LIMIT_RPM=10
SIGNALS_CANDLE_CACHE_TTL_MINUTES=10
SIGNALS_SIGNAL_CACHE_TTL_MINUTES=5
ORDER_EMAIL_SMTP_HOST=
ORDER_EMAIL_SMTP_PORT=587
ORDER_EMAIL_SMTP_TLS=starttls
ORDER_EMAIL_SMTP_USERNAME=
ORDER_EMAIL_SMTP_PASSWORD=
ORDER_EMAIL_FROM=noreply@etpteamriya.com
ORDER_EMAIL_FROM_DOMAINS=etpteamriya.com
ORDER_EMAIL_ALLOWED_RECIPIENT_DOMAINS=
ORDER_EMAIL_REPLY_TO=
ORDER_EMAIL_MAX_PER_MINUTE=60

# ---- executor-service (Spring Boot)
SERVICES_EXECUTOR_PORT=8082
SERVICES_ORDER_HOST=localhost
EXECUTOR_POLL_INTERVAL_SECONDS=60
EXECUTOR_WATCH_SYMBOLS=
EXECUTOR_STRATEGY_EXECUTION_ENABLED=true
EXECUTOR_STRATEGY_DEMO_DELAY_MILLIS=0

# ---- frontend and the Playwright journeys
E2E_BASE_URL=http://localhost:4200
E2E_MAILHOG_URL=http://localhost:8025
E2E_USERNAME=
E2E_PASSWORD=
E2E_READONLY_USERNAME=
E2E_READONLY_PASSWORD=
E2E_SYMBOL=AAPL

# ---- docker compose (ports and the database containers)
FRONTEND_PORT=4200
AUTH_PORT=3000
ORDER_PORT=8081
EXECUTOR_PORT=8082
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=trading_db
TRADING_DB_PORT=5432
AUTH_POSTGRES_USER=postgres
AUTH_POSTGRES_PASSWORD=
AUTH_POSTGRES_DB=auth_db
AUTH_DB_PORT=5432
KAFKA_PORT=9092
KAFKA_EXTERNAL_HOST=localhost
PUBLIC_AUTH_URL=

