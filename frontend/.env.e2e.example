# Copy to .env.e2e and fill in. Real values, real accounts: these journeys run against the live stack.
# QUOTE passwords: an unquoted # starts a comment and silently truncates the value (pass#word -> pass).
# .env.e2e is git-ignored. Never commit real credentials.

# Address of the running Angular app (ng serve proxies /api to the order and executor services).
E2E_BASE_URL=http://localhost:4200

# A user with a LINKED, ACTIVE trading account and enough cash to buy one share of E2E_SYMBOL.
E2E_USERNAME=<fill-in>
E2E_PASSWORD="<fill-in>"

# A user whose linked account is NOT active (SUSPENDED or CLOSED), so it cannot place orders.
E2E_READONLY_USERNAME=<fill-in>
E2E_READONLY_PASSWORD="<fill-in>"

# A symbol that appears on the dashboard market board and has a live price (e.g. AAPL).
E2E_SYMBOL=<fill-in>

# Registering and two-step sign-in email a code. These journeys read it from MailHog's web interface, so MailHog must be
# running (docker compose --profile dev-mail up -d mailhog) and the auth service started with AUTH_EMAIL_ENABLED=true.
# A plain sign-in needs no mail: two-step is off for a user until they switch it on in Settings.
E2E_MAILHOG_URL=http://localhost:8025

