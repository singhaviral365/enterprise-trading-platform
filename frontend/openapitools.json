{
  "$schema": "./node_modules/@openapitools/openapi-generator-cli/config.schema.json",
  "spaces": 2,
  "generator-cli": {
    "version": "7.25.0",
    "generators": {
      "auth-api": {
        "generatorName": "typescript-angular",
        "inputSpec": "../contracts/auth-api.yaml",
        "output": "src/app/api/generated/auth",
        "skipValidateSpec": true,
        "additionalProperties": {
          "ngVersion": "20.0.0",
          "providedIn": "root",
          "withInterfaces": true,
          "stringEnums": true
        },
        "globalProperty": "apis,models,supportingFiles=api.base.service.ts:api.module.ts:configuration.ts:encoder.ts:index.ts:param.ts:provide-api.ts:query.params.ts:variables.ts:models.ts:api.ts"
      },
      "trade-api": {
        "generatorName": "typescript-angular",
        "inputSpec": "../contracts/trade-api.yaml",
        "output": "src/app/api/generated/trade",
        "skipValidateSpec": true,
        "additionalProperties": {
          "ngVersion": "20.0.0",
          "providedIn": "root",
          "withInterfaces": true,
          "stringEnums": true
        },
        "globalProperty": "apis,models,supportingFiles=api.base.service.ts:api.module.ts:configuration.ts:encoder.ts:index.ts:param.ts:provide-api.ts:query.params.ts:variables.ts:models.ts:api.ts"
      }
    }
  }
}
