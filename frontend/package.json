{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "api:generate": "node -e \"require('fs').rmSync('src/app/api/generated',{recursive:true,force:true})\" && openapi-generator-cli generate",
    "api:check": "npm run api:generate && git diff --exit-code -- src/app/api/generated",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "test:ci": "ng test --watch=false --coverage",
    "test:report": "vite preview --outDir test-reports/html --open",
    "coverage:report": "vite preview --outDir coverage/frontend --open"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "highcharts": "^13.1.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.7",
    "@angular/cli": "^22.0.7",
    "@angular/compiler-cli": "^22.0.0",
    "@openapitools/openapi-generator-cli": "2.41.0",
    "@playwright/test": "^1.55.0",
    "@vitest/coverage-istanbul": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "basic-ftp": "^6.2.1"
  },
  "allowScripts": {
    "@openapitools/openapi-generator-cli@2.41.0": true,
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
