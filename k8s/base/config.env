# ---- executor-service (Spring Boot)
SERVICES_EXECUTOR_PORT=8082
# The order-service relays /api/v1/market to the executor at this host (MarketProxyController).
SERVICES_EXECUTOR_HOST=executor-service
SERVICES_ORDER_HOST=localhost
EXECUTOR_POLL_INTERVAL_SECONDS=900
EXECUTOR_WATCH_SYMBOLS=
EXECUTOR_STRATEGY_EXECUTION_ENABLED=true
EXECUTOR_STRATEGY_DEMO_DELAY_MILLIS=0

# ---- frontend and the Playwright journeys
E2E_BASE_URL=http://localhost:4200
E2E_MAILHOG_URL=http://localhost:8025
E2E_USERNAME=
E2E_PASSWORD=
E2E_READONLY_USERNAME=
E2E_READONLY_PASSWORD=
E2E_SYMBOL=AAPL

# ---- docker compose: profiles, public address and the one database (trading_db: schemas trading and auth)
COMPOSE_PROJECT_NAME=trading-platform
# RDS: remove "localdb" from the profiles and set DB_HOST to the RDS endpoint.
COMPOSE_PROFILES=localdb,kafka,auth-service,order-service,executor-service,frontend
# The address typed in the browser (server IP / DNS, or localhost). Keep AUTH_CORS_ORIGINS and FRONTEND_URL_REWRITES in step with it.
PUBLIC_HOST=localhost
DB_HOST=database-1.cbo04g6kafop.ap-south-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=trading_db
DB_SCHEMA_TRADING=trading
DB_SCHEMA_AUTH=auth
DB_USER=postgres
DB_PASSWORD=n3u3d4!!
DB_HOST_PORT=5432
DB_INIT_DIR=./databases/PostgreSQL
DB_SEED_DIR=./databases/PostgreSQL

# ---- docker compose: database SSL (RDS rejects unencrypted connections; the bundled Postgres also accepts SSL)
# order and executor (JDBC): encrypt, do not verify the certificate chain. Starts with "&": it is appended to ?currentSchema=...
JDBC_PARAMS=&sslmode=require
# auth-service (node-postgres): encrypt without verifying the certificate. Plain "require" would fail on RDS with
# "self-signed certificate in certificate chain", because the RDS CA is not in Node's trust store. db-seed overrides this with "require".
PGSSLMODE=no-verify

# ---- docker compose: services, ports and the frontend routes
AUTH_SERVICE_DIR=./services/auth-service
AUTH_SERVICE_PORT=3000
AUTH_SERVICE_HEALTH_PATH=/health
ORDER_SERVICE_DIR=./services/order-service
ORDER_SERVICE_PORT=8081
ORDER_SERVICE_HEALTH_PATH=/actuator/health
EXECUTOR_SERVICE_DIR=./services/executor-service
EXECUTOR_SERVICE_PORT=8082
FRONTEND_DIR=./frontend
FRONTEND_PORT=4200
# The browser only talks to the frontend port: nginx forwards /_auth, /_order and the market-data route to the services,
# so the browser never makes a cross-origin call. If PUBLIC_HOST is not localhost, replace "localhost:4200" on the right-hand sides.
FRONTEND_URL_REWRITES='http://localhost:3000=http://localhost:4200/_auth http://localhost:8081=http://localhost:4200/_order http://localhost:8082=http://localhost:4200'
FRONTEND_EXTRA_DIR=./config
FRONTEND_EXTRA_DEST=/config
FRONTEND_PRE_BUILD_CMD='npm --prefix /config ci && mkdir -p /app/src/app/config && ln -sfn /app /frontend'
FRONTEND_PROXY_KEEP_PATHS=__unused__
FRONTEND_PROXY_KEEP_TARGET=http://order-service:8081
FRONTEND_PROXY_KEEP2_PATHS=api
FRONTEND_PROXY_KEEP2_TARGET=http://order-service:8081
KAFKA_TOPICS='orders:3:604800000 trade-events:3:2592000000 market-data:6:86400000 orders.DLT:1:604800000 trade-events.DLT:1:2592000000 market-data.DLT:1:86400000'
KAFKA_HOST_PORT=9092