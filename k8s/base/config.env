# Every environment variable the platform uses, by the part that reads it. Copy it to .env and fill in the blanks.
# Blank = a secret or an account you must supply: passwords, API keys, the JWT secret, the encryption key, the SMTP account.
# Under docker compose, docker-compose-new.yml overrides the database, Kafka and CORS values below with the in-network ones
# (DB_*), so the DATABASE_* values here only matter when you run a service outside Docker.

# ---- Shared by the auth, order and executor services
JWT_SECRET=5d5634fe6f76a4b6a9dd5e94502fbe2519958a10bae499a12a447871546a6ef5
JWT_ISSUER=auth-service
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ---- auth-service (NestJS)
# NODE_ENV=production makes cookies Secure: they would be dropped over plain http. Keep "local" until the site is on https.
NODE_ENV=local
PORT=3000
LOG_LEVEL=debug
DATABASE_HOST=database-1.cbo04g6kafop.ap-south-1.rds.amazonaws.com
DATABASE_PORT=5432
DATABASE_NAME=trading_db
DATABASE_SCHEMA=auth
DATABASE_USER=postgres
DATABASE_PASSWORD=n3u3d4!!
JWT_ACCESS_TOKEN_EXPIRES_IN=900
JWT_REFRESH_TOKEN_EXPIRES_IN=604800
AUTH_COOKIE_SECURE=
AUTH_COOKIE_SAMESITE=strict
# CORS: the exact origin(s) the browser page is served from (scheme + host + port, no trailing slash), comma separated.
# Must match PUBLIC_HOST and FRONTEND_PORT below. Opening the site by server IP? Put that origin here too.
AUTH_CORS_ORIGINS=*
AUTH_EMAIL_VERIFICATION_ENABLED=false
AUTH_TWO_FACTOR_ENABLED=true
AUTH_OTP_SECRET=
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_RESET_TTL_SECONDS=600
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN_SECONDS=30
AUTH_OTP_MAX_SENDS=3
AUTH_EMAIL_MODE=prod
AUTH_EMAIL_SMTP_HOST=smtp.gmail.com
AUTH_EMAIL_SMTP_PORT=587
AUTH_EMAIL_SMTP_TLS=starttls
AUTH_EMAIL_SMTP_USER=mit2022506079@gmail.com
AUTH_EMAIL_SMTP_PASSWORD='jdxn lwio qvql kqez'
AUTH_EMAIL_FROM=mit2022506079@gmail.com
AUTH_EMAIL_FROM_DOMAINS=gmail.com
AUTH_EMAIL_ALLOWED_RECIPIENT_DOMAINS=*
AUTH_EMAIL_REPLY_TO=
MAILHOG_HOST=localhost
MAILHOG_SMTP_PORT=1025
ENC_MODE=off
ENC_KID=
ENC_PRIVATE_KEY_PEM=
ENC_MAX_AGE_SECONDS=60
ENC_LOG_PLAINTEXT=false

