# Non-secret settings. Safe to commit. Secrets live in secrets.local.env; merge both into .env with:  ./scripts/build-env.sh
# Public address: for another host, change PUBLIC_HOST and the 43.204.211.3 values (AUTH_CORS_ORIGINS, FRONTEND_URL_REWRITES).

# ---- Shared by the auth, order and executor services
JWT_ISSUER=auth-service
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# ---- auth-service (NestJS)
# NODE_ENV=production makes cookies Secure: they would be dropped over plain http. Keep "local" until the site is on https.
NODE_ENV=local
PORT=3000
LOG_LEVEL=debug
DATABASE_HOST=database-1.cp0qc4yoaitv.ap-south-1.rds.amazonaws.com
DATABASE_PORT=5432
DATABASE_NAME=trading_db
DATABASE_SCHEMA=auth
DATABASE_USER=postgres
JWT_ACCESS_TOKEN_EXPIRES_IN=900
JWT_REFRESH_TOKEN_EXPIRES_IN=604800
AUTH_COOKIE_SECURE=
AUTH_COOKIE_SAMESITE=strict

# CORS: the exact origin the browser page is served from (scheme + host + port, no trailing slash), comma separated. "*" does not work here.
AUTH_CORS_ORIGINS=*
AUTH_EMAIL_VERIFICATION_ENABLED=false
AUTH_TWO_FACTOR_ENABLED=true
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_RESET_TTL_SECONDS=600
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN_SECONDS=30
AUTH_OTP_MAX_SENDS=3
AUTH_EMAIL_MODE=prod
AUTH_EMAIL_SMTP_HOST=smtp.gmail.com
AUTH_EMAIL_SMTP_PORT=587
AUTH_EMAIL_SMTP_TLS=starttls
AUTH_EMAIL_SMTP_USER=mit2022506079@gmail.com
AUTH_EMAIL_FROM=mit2022506079@gmail.com
AUTH_EMAIL_FROM_DOMAINS=gmail.com
AUTH_EMAIL_ALLOWED_RECIPIENT_DOMAINS=*
AUTH_EMAIL_REPLY_TO=
MAILHOG_HOST=localhost
MAILHOG_SMTP_PORT=1025
ENC_MODE=off
ENC_KID=
ENC_MAX_AGE_SECONDS=60
ENC_LOG_PLAINTEXT=false

# ---- order-service (Spring Boot)
SPRING_PROFILES_ACTIVE=prod
SERVICES_ORDER_PORT=8081
SERVICES_MAILHOG_HOST=localhost
SERVICES_MAILHOG_SMTP_PORT=1025
DATABASE_TRADING_HOST=database-1.cp0qc4yoaitv.ap-south-1.rds.amazonaws.com
DATABASE_TRADING_PORT=5432
DATABASE_TRADING_NAME=trading_db
DATABASE_TRADING_SCHEMA=trading
DATABASE_TRADING_USER=postgres
EXTERNAL_FAUXNANCE_BASE_URL=https://y4t9nq2bqf.execute-api.eu-west-2.amazonaws.com/v1
EXTERNAL_EXCHANGE_RATE_BASE_URL=https://v6.exchangerate-api.com/v6
EXTERNAL_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
EXTERNAL_GEMINI_MODEL=gemini-flash-lite-latest
EXTERNAL_GEMINI_RATE_LIMIT_RPM=10
SIGNALS_CANDLE_CACHE_TTL_MINUTES=60
SIGNALS_SIGNAL_CACHE_TTL_MINUTES=60
ORDER_EMAIL_SMTP_HOST=smtp.gmail.com
ORDER_EMAIL_SMTP_PORT=587
ORDER_EMAIL_SMTP_TLS=starttls
ORDER_EMAIL_SMTP_USERNAME=mit2022506079@gmail.com
ORDER_EMAIL_FROM=mit2022506079@gmail.com
ORDER_EMAIL_FROM_DOMAINS=gmail.com
ORDER_EMAIL_ALLOWED_RECIPIENT_DOMAINS=*
ORDER_EMAIL_REPLY_TO=
ORDER_EMAIL_MAX_PER_MINUTE=60

# ---- executor-service (Spring Boot)
SERVICES_EXECUTOR_PORT=8082
SERVICES_ORDER_HOST=order-service
EXECUTOR_POLL_INTERVAL_SECONDS=3600
# Market-board cache (executor): the dashboard reuses one Fauxnance fetch for this long. Spring reads it as trading.market.cache-ttl-seconds.
TRADING_MARKET_CACHE_TTL_SECONDS=3600
EXECUTOR_WATCH_SYMBOLS=
EXECUTOR_STRATEGY_EXECUTION_ENABLED=true
EXECUTOR_STRATEGY_DEMO_DELAY_MILLIS=0

# ---- frontend and the Playwright journeys
E2E_BASE_URL=http://localhost:4200
E2E_MAILHOG_URL=http://localhost:8025
E2E_USERNAME=
E2E_READONLY_USERNAME=
E2E_SYMBOL=AAPL

# ---- docker compose: profiles, public address and the one database (trading_db: schemas trading and auth)
COMPOSE_PROJECT_NAME=trading-platform
# Database on RDS, so no "localdb" profile.
COMPOSE_PROFILES=DB_HOST,kafka,auth-service,order-service,executor-service,frontend
PUBLIC_HOST=localhost
DB_HOST=database-1.cp0qc4yoaitv.ap-south-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=trading_db
DB_SCHEMA_TRADING=trading
DB_SCHEMA_AUTH=auth
DB_USER=postgres
DB_HOST_PORT=5432
DB_INIT_DIR=./databases/PostgreSQL
DB_SEED_DIR=./databases/PostgreSQL
DB_SSL=false
PGSSLMODE=no-verify
# ---- docker compose: database SSL (RDS rejects unencrypted connections)
# order and executor (JDBC): encrypt, do not verify the certificate chain. Starts with "&": appended to ?currentSchema=...
JDBC_PARAMS=&sslmode=require
# auth-service (node-postgres): encrypt without verifying the certificate (the RDS CA is not in Node's trust store).

# ---- docker compose: services, ports and the frontend routes
AUTH_SERVICE_DIR=./services/auth-service
AUTH_SERVICE_PORT=3000
AUTH_SERVICE_HEALTH_PATH=/health
ORDER_SERVICE_DIR=./services/order-service
ORDER_SERVICE_PORT=8081
ORDER_SERVICE_HEALTH_PATH=/actuator/health
EXECUTOR_SERVICE_DIR=./services/executor-service
EXECUTOR_SERVICE_PORT=8082
FRONTEND_DIR=./frontend
FRONTEND_PORT=4200
# The browser only talks to the frontend port: nginx forwards /_auth, /_order and the market-data route to the services.

FRONTEND_URL_REWRITES='http://localhost:3000=http://localhost:4200/_auth http://localhost:8081=http://localhost:4200/_order http://localhost:8082=http://localhost:4200'FRONTEND_EXTRA_DIR=./config
FRONTEND_EXTRA_DEST=/config
FRONTEND_PRE_BUILD_CMD='npm --prefix /config ci && mkdir -p /app/src/app/config && ln -sfn /app /frontend'
FRONTEND_PROXY_KEEP_PATHS=api/v1/market
FRONTEND_PROXY_KEEP_TARGET=http://executor-service:8082
FRONTEND_PROXY_KEEP2_PATHS=api
FRONTEND_PROXY_KEEP2_TARGET=http://order-service:8081
KAFKA_TOPICS='orders:3:604800000 trade-events:3:2592000000 market-data:6:86400000 orders.DLT:1:604800000 trade-events.DLT:1:2592000000 market-data.DLT:1:86400000'
KAFKA_HOST_PORT=9092
