# PostgreSQL Configuration
POSTGRES_DB=trading_db
POSTGRES_USER=postgres
DB_PASSWORD=

# JWT Secret for auth-stub
JWT_SECRET=
JWT_ISSUER=auth-service

# Auth service: two-step sign-in and forgot password email a 6-digit code. Email is DEVELOPMENT ONLY (MailHog, a local
# SMTP catcher: docker compose --profile dev-mail up -d mailhog, read the mail at http://localhost:8025). The service
# refuses to start with email on outside development, or with a non-local SMTP host. Two-step sign-in is ON by default and
# needs email, so for development set AUTH_EMAIL_ENABLED=true (or AUTH_EMAIL_VERIFICATION_ENABLED=false to skip the check).
# Registering emails a code to the address typed first (AUTH_EMAIL_VERIFICATION_ENABLED, on by default). Two-step sign-in is
# each user's own choice, off until they switch it on in Settings; AUTH_TWO_FACTOR_ENABLED=false removes that option.
# AUTH_EMAIL_ENABLED=true
# AUTH_EMAIL_VERIFICATION_ENABLED=true
# AUTH_EMAIL_SMTP_HOST=localhost
# AUTH_EMAIL_SMTP_PORT=1025
# AUTH_TWO_FACTOR_ENABLED=true
# AUTH_OTP_TTL_SECONDS=300
# AUTH_OTP_MAX_ATTEMPTS=5

# Kafka external advertised host (set to VM IP when clients connect remotely)
KAFKA_EXTERNAL_HOST={LINUX_IP}
KAFKA_BOOTSTRAP_SERVERS={LINUX_IP}:9092

# Fauxnance base URL (provided by the programme)
FAUXNANCE_BASE_URL=https://y4t9nq2bqf.execute-api.eu-west-2.amazonaws.com/v1

# Fauxnance API Key (required for production)
FAUXNANCE_API_KEY=

# ExchangeRate-API (https://www.exchangerate-api.com). Used by order-service and executor-service to convert
# prices between an instrument's currency and the account currency. The browser never calls it.
# URL is the base WITHOUT the key; the services build {URL}/{KEY}/latest/USD.
EXCHANGE_RATE_API_URL=https://v6.exchangerate-api.com/v6
EXCHANGE_RATE_API_KEY=

CORE_JAVA_REPO_URL=
