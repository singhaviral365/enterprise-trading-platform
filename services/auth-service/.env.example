# PostgreSQL Configuration
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=auth_db
DATABASE_USER=postgres
DATABASE_PASSWORD=

# JWT Secret for auth-stub
JWT_SECRET=
JWT_ISSUER=auth-service

# Session cookies (access_token and refresh_token, both HttpOnly).
# AUTH_COOKIE_SECURE defaults to true when NODE_ENV=production and false otherwise.
# AUTH_COOKIE_SAMESITE is strict (default), lax, or none (front end on another site; forces Secure).
# AUTH_COOKIE_SECURE=false
# AUTH_COOKIE_SAMESITE=strict