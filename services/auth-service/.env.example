# PostgreSQL Configuration
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=auth_db
DATABASE_USER=postgres
DATABASE_PASSWORD=

# JWT Secret for auth-stub
JWT_SECRET=
JWT_ISSUER=auth-service

# Session cookies (access_token and refresh_token, both HttpOnly).
# AUTH_COOKIE_SECURE defaults to true when NODE_ENV=production and false otherwise.
# AUTH_COOKIE_SAMESITE is strict (default), lax, or none (front end on another site; forces Secure).
# AUTH_COOKIE_SECURE=false
# AUTH_COOKIE_SAMESITE=strict


# --- Email (documentation/readme/EMAIL.md) ------------------------------------------
# Off by default. Registration emails a code, so with AUTH_EMAIL_VERIFICATION_ENABLED=true (the default) you need a mode other than off,
# or set that to false. Two-step sign-in is each user's own choice, off until they switch it on in Settings.
#   dev   MailHog on your machine (localhost:1025, read the mail at http://localhost:8025)
#   prod  a real SMTP account over TLS. Example: Gmail with an app password (Google account > Security > 2-Step Verification > App passwords)
# AUTH_EMAIL_MODE=prod
# AUTH_EMAIL_SMTP_HOST=smtp.gmail.com
# AUTH_EMAIL_SMTP_PORT=587
# AUTH_EMAIL_SMTP_TLS=starttls
# AUTH_EMAIL_SMTP_USER=you@gmail.com
# AUTH_EMAIL_SMTP_PASSWORD=
# AUTH_EMAIL_FROM=you@gmail.com
# AUTH_EMAIL_FROM_DOMAINS=gmail.com
# Outside NODE_ENV=production a real-mail setup must say who may receive mail. * means anyone; a comma list of domains restricts it.
# AUTH_EMAIL_ALLOWED_RECIPIENT_DOMAINS=*
# AUTH_EMAIL_VERIFICATION_ENABLED=true
# AUTH_TWO_FACTOR_ENABLED=true
# AUTH_OTP_TTL_SECONDS=300
# AUTH_OTP_MAX_ATTEMPTS=5

# --- Payload encryption (documentation/todo/02-payload-encryption.md) --------------
# off (default), optional or required. Generate the key with `npm run enc:keygen`; the private key stays out of git.
# ENC_MODE=off
# ENC_KID=
# ENC_PRIVATE_KEY_PEM=
