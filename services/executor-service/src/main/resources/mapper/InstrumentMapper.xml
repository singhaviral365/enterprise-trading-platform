<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.example.backend.mapper.InstrumentMapper">

    <resultMap id="InstrumentResultMap"
               type="org.example.backend.entities.Instrument">

        <constructor>
            <idArg column="instrument_id"
                   javaType="_int"
                   name="instrumentId"/>

            <arg column="instrument_ticker"
                 javaType="String"
                 name="instrumentTicker"/>

            <arg column="instrument_name"
                 javaType="String"
                 name="instrumentName"/>

            <arg column="asset_class"
                 javaType="org.example.backend.enums.InstrumentAssetClass"
                 name="assetClass"/>

            <arg column="instrument_status"
                 javaType="org.example.backend.enums.InstrumentStatus"
                 name="instrumentStatus"/>

            <arg column="currency"
                 javaType="String"
                 name="currency"/>

            <arg column="icon_url"
                 javaType="String"
                 name="iconUrl"/>
        </constructor>

    </resultMap>

    <select id="selectInstrumentById"
            resultMap="InstrumentResultMap">

        SELECT
            instrument_id,
            instrument_ticker,
            instrument_name,
            asset_class,
            instrument_status,
            currency,
            icon_url

        FROM instrument

        WHERE instrument_id = #{instrumentId}

    </select>

    <select id="selectInstrumentByTicker"
            resultMap="InstrumentResultMap">

        SELECT
            instrument_id,
            instrument_ticker,
            instrument_name,
            asset_class,
            instrument_status,
            currency,
            icon_url

        FROM instrument

        WHERE instrument_ticker = #{ticker}

    </select>

    <select id="selectTradableInstruments"
            resultMap="InstrumentResultMap">

        SELECT
            instrument_id,
            instrument_ticker,
            instrument_name,
            asset_class,
            instrument_status,
            currency,
            icon_url

        FROM instrument

        WHERE instrument_status = 'TRADING'

        ORDER BY instrument_ticker

    </select>

        <select id="selectSymbolsForMarketPolling"
                        resultType="String">

                SELECT DISTINCT instrument_ticker

                FROM instrument

                WHERE instrument_status = 'TRADING'

                ORDER BY instrument_ticker

        </select>

        <!--
          Symbols customers are watching. Kept as its own statement (not folded into the query
          above) so that if the watchlist tables do not exist yet, only this lookup fails and the
          poller still prices held and open-order symbols.
        -->
        <!-- Symbols a strategy is waiting on. Looked up separately, like the watchlist symbols, so a database without the strategy
             table only loses this one lookup. -->
        <select id="selectStrategySymbolsForMarketPolling"
                        resultType="String">

                SELECT DISTINCT i.instrument_ticker

                FROM instrument i

                JOIN strategy s
                        ON s.instrument_id = i.instrument_id

                WHERE i.instrument_status = 'TRADING'
                  AND s.status IN ('ACTIVE', 'EXECUTING')

                ORDER BY i.instrument_ticker

        </select>

        <select id="selectWatchlistSymbolsForMarketPolling"
                        resultType="String">

                SELECT DISTINCT i.instrument_ticker

                FROM instrument i

                JOIN watchlist_item w
                        ON w.ticker_symbol = i.instrument_ticker

                WHERE i.instrument_status = 'TRADING'

                ORDER BY i.instrument_ticker

        </select>

</mapper>