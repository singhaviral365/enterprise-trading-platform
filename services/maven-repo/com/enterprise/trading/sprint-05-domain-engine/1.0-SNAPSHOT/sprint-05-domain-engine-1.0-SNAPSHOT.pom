<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.enterprise.trading</groupId>
    <artifactId>sprint-05-domain-engine</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <junit.version>5.10.3</junit.version>
        <jakarta.validation.version>3.1.0</jakarta.validation.version>
        <maven.surefire.version>3.5.3</maven.surefire.version>
        <maven.enforcer.version>3.6.1</maven.enforcer.version>
    </properties>

    <dependencies>

        <!-- Only allowed non-test dependency -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <version>${jakarta.validation.version}</version>
        </dependency>

        <!-- JUnit 5 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <!-- Java 21 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>

            <!-- JUnit 5 / Surefire -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.version}</version>
            </plugin>

            <!-- Dependency ban -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven.enforcer.version}</version>

                <executions>
                    <execution>
                        <id>ban-forbidden-dependencies</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>

                        <configuration>
                            <rules>

                                <bannedDependencies>
                                    <excludes>

                                        <!-- Spring -->
                                        <exclude>org.springframework:*</exclude>
                                        <exclude>org.springframework.boot:*</exclude>
                                        <exclude>org.springframework.data:*</exclude>

                                        <!-- Servlet API -->
                                        <exclude>jakarta.servlet:*</exclude>
                                        <exclude>javax.servlet:*</exclude>

                                        <!-- JDBC drivers -->
                                        <exclude>org.postgresql:*</exclude>
                                        <exclude>com.mysql:*</exclude>
                                        <exclude>com.microsoft.sqlserver:*</exclude>
                                        <exclude>com.oracle.database.jdbc:*</exclude>

                                        <!-- MyBatis -->
                                        <exclude>org.mybatis:*</exclude>

                                        <!-- HikariCP -->
                                        <exclude>com.zaxxer:HikariCP</exclude>

                                    </excludes>

                                    <message>
                                        Forbidden dependency detected.
                                        The Enterprise Trading domain must remain
                                        framework-independent. Spring, Servlet API,
                                        JDBC drivers, MyBatis and connection pools
                                        are not permitted.
                                    </message>
                                </bannedDependencies>

                            </rules>

                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>